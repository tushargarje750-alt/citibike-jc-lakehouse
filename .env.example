# Copy this file to .env and fill in real values.  .env is git-ignored; this file is not.
# No quotes, no spaces around "=".

# SQL warehouse > Connection details > Server hostname (no https://)
DBT_DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com

# SQL warehouse > Connection details > HTTP path
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Settings > Developer > Access tokens.  The DBT_ENV_SECRET_ prefix makes dbt mask it in logs.
DBT_ENV_SECRET_DATABRICKS_TOKEN=dapiREPLACE_ME

# Unity Catalog catalog that holds all project schemas
DBT_CATALOG=workspace
