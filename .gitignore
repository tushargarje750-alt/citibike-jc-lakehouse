*.tfstate
*.tfstate.*
crash.log

# --- Databricks CLI / bundles ---
.databricks/

# --- local data downloads ---
data/

# --- macOS / editors ---
.DS_Store
.idea/
.vscode/

# --- test caches ---
.pytest_cache/
