{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "Headline numbers",
      "queryLines": [
        "SELECT\n",
        "  sum(trips)                                            AS total_trips,\n",
        "  cast(round(avg(trips)) AS BIGINT)                     AS avg_trips_per_day,\n",
        "  round(100 * sum(member_trips) / sum(trips), 1)        AS member_share_pct,\n",
        "  round(100 * sum(electric_trips) / sum(trips), 1)      AS electric_share_pct\n",
        "FROM workspace.citibike_gold.daily_ridership\n"
      ]
    },
    {
      "name": "ds_monthly",
      "displayName": "Trips per month by rider type",
      "queryLines": [
        "SELECT\n",
        "  ride_month,\n",
        "  sum(member_trips) AS member_trips,\n",
        "  sum(casual_trips) AS casual_trips\n",
        "FROM workspace.citibike_gold.daily_ridership\n",
        "GROUP BY ride_month\n",
        "ORDER BY ride_month\n"
      ]
    },
    {
      "name": "ds_top_stations",
      "displayName": "Top 10 start stations",
      "queryLines": [
        "SELECT\n",
        "  concat(lpad(cast(start_rank AS STRING), 2, '0'), '  ', station_name) AS station,\n",
        "  area,\n",
        "  trips_started\n",
        "FROM workspace.citibike_gold.top_stations\n",
        "WHERE start_rank <= 10\n",
        "ORDER BY start_rank\n"
      ]
    },
    {
      "name": "ds_peak_hours",
      "displayName": "Trips per hour on a typical weekday and weekend day",
      "queryLines": [
        "WITH days AS (\n",
        "  SELECT is_weekend, sum(days_observed) AS days\n",
        "  FROM (SELECT DISTINCT day_of_week, is_weekend, days_observed FROM workspace.citibike_gold.peak_hours)\n",
        "  GROUP BY is_weekend\n",
        "),\n",
        "hourly AS (\n",
        "  SELECT is_weekend, started_hour, sum(trips) AS trips\n",
        "  FROM workspace.citibike_gold.peak_hours\n",
        "  GROUP BY is_weekend, started_hour\n",
        ")\n",
        "SELECT\n",
        "  hourly.started_hour,\n",
        "  round(max(CASE WHEN NOT hourly.is_weekend THEN hourly.trips / days.days END), 1) AS weekday_trips,\n",
        "  round(max(CASE WHEN hourly.is_weekend THEN hourly.trips / days.days END), 1)     AS weekend_trips\n",
        "FROM hourly\n",
        "JOIN days ON days.is_weekend = hourly.is_weekend\n",
        "GROUP BY hourly.started_hour\n",
        "ORDER BY hourly.started_hour\n"
      ]
    },
    {
      "name": "ds_duration",
      "displayName": "Median trip length per month by rider type",
      "queryLines": [
        "SELECT\n",
        "  ride_month,\n",
        "  max(CASE WHEN member_casual = 'member' THEN median_duration_minutes END) AS member_median_minutes,\n",
        "  max(CASE WHEN member_casual = 'casual' THEN median_duration_minutes END) AS casual_median_minutes\n",
        "FROM workspace.citibike_gold.member_vs_casual\n",
        "GROUP BY ride_month\n",
        "ORDER BY ride_month\n"
      ]
    },
    {
      "name": "ds_weather",
      "displayName": "Ridership index by temperature and rain",
      "queryLines": [
        "SELECT\n",
        "  CASE temperature_band\n",
        "    WHEN 'freezing' THEN '1 Freezing (below 0 C)'\n",
        "    WHEN 'cold'     THEN '2 Cold (0-10 C)'\n",
        "    WHEN 'mild'     THEN '3 Mild (10-20 C)'\n",
        "    WHEN 'warm'     THEN '4 Warm (20-27 C)'\n",
        "    ELSE                 '5 Hot (27 C and up)'\n",
        "  END                                                    AS temperature,\n",
        "  CASE WHEN is_wet_day THEN 'Wet day (1 mm or more)' ELSE 'Dry day' END AS conditions,\n",
        "  round(sum(avg_ridership_index * days) / sum(days), 3)  AS ridership_index\n",
        "FROM workspace.citibike_gold.weather_impact\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1, 2\n"
      ]
    },
    {
      "name": "ds_daily_weather",
      "displayName": "Daily trips and temperature",
      "queryLines": [
        "SELECT\n",
        "  ride_date,\n",
        "  temperature_mean_c,\n",
        "  trips,\n",
        "  CASE WHEN is_wet_day THEN 'Wet day (1 mm or more)' ELSE 'Dry day' END AS conditions\n",
        "FROM workspace.citibike_gold.daily_ridership\n",
        "WHERE temperature_mean_c IS NOT NULL\n"
      ]
    }
  ],
